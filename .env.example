# Set these in Vercel Project Settings > Environment Variables.
# Never put real secrets in public HTML/JS or commit them to GitHub.
SEND_MAGICLINK_URL=https://your-api.example/send-magiclink
VERIFY_ACCOUNT_URL=https://your-api.example/verify-account
APPLY_PREMIUM_URL=https://your-api.example/apply-premium
API_KEY=replace_with_your_secret_key
# Optional: x-api-key (default), Authorization, or another header name your API requires
API_KEY_HEADER=x-api-key
# Optional: bearer sends Authorization: Bearer <API_KEY>
API_KEY_PREFIX=
